<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane fitToWidth="true" prefWidth="270" hbarPolicy="NEVER" style="-fx-background-color: transparent;"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.imagemanager.controller.FilterController">
    <VBox spacing="12" prefWidth="250" styleClass="panel">
        <!-- FILTRES COULEUR -->
        <Label text="🎨 FILTRES COULEUR" styleClass="section-label" style="-fx-padding: 12 0 4 0;"/>
        <Button text="Noir et Blanc" onAction="#applyGrayscale" maxWidth="Infinity" styleClass="btn-filter-grayscale"/>
        <Button text="Sepia" onAction="#applySepia" maxWidth="Infinity" styleClass="btn-filter-sepia"/>
        <Button text="Échange RGB" onAction="#applyRGBSwap" maxWidth="Infinity" styleClass="btn-filter-rgb"/>
        <Button text="Contours (Prewitt)" onAction="#applyPrewitt" maxWidth="Infinity" styleClass="btn-filter-prewitt"/>

        <!-- TRANSFORMATIONS -->
        <Label text="🔄 TRANSFORMATIONS" styleClass="section-label" style="-fx-padding: 12 0 4 0;"/>
        <Button text="↻ Rotation Droite" onAction="#rotateRight" maxWidth="Infinity" styleClass="btn-filter-geometry"/>
        <Button text="↺ Rotation Gauche" onAction="#rotateLeft" maxWidth="Infinity" styleClass="btn-filter-geometry"/>
        <Button text="⇆ Symétrie Horizontale" onAction="#applyHorizontalSymmetry" maxWidth="Infinity" styleClass="btn-filter-geometry"/>
        <Button text="⇅ Symétrie Verticale" onAction="#applyVerticalSymmetry" maxWidth="Infinity" styleClass="btn-filter-geometry"/>

        <!-- SÉCURITÉ -->
        <Label text="🔒 SÉCURITÉ" styleClass="section-label" style="-fx-padding: 12 0 4 0;"/>
        <Button text="🔐 Chiffrer" onAction="#encryptImage" maxWidth="Infinity" styleClass="btn-security"/>
        <Button text="🔓 Déchiffrer" onAction="#decryptImage" maxWidth="Infinity" styleClass="btn-security"/>

        <!-- ACTIONS -->
        <Label text="⚙️ ACTIONS" styleClass="section-label" style="-fx-padding: 12 0 4 0;"/>
        <Button text="↶ Réinitialiser" onAction="#resetImage" maxWidth="Infinity" styleClass="btn-reset"/>
    </VBox>
</ScrollPane>

